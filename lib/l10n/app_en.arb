  "@adminResetFormIncompleteNotice": {"description": "本地只擋「明顯沒填」，其餘規則以服務端為準。"},
  "adminResetInvalidPasswordNotice": "That password does not meet the server's credential rules (non-empty and within the length limit).",
  "@adminResetInvalidPasswordNotice": {"description": "1004 點名 password 欄位的一句：只轉述形狀界線，不復述任何輸入內容。"},
  "adminStatusConflictNotice": "This administrator's status changed after you opened this record, so nothing was done: no status change, no sessions revoked, no audit entry. Reload to see the current status before deciding again.",
  "@adminStatusConflictNotice": {"description": "2014 的一句：一件都沒發生；處置是重讀現狀並重新確認，不是再點一次按鈕。"},
  "adminProfileDeletedNotice": "This administrator has been deleted, so this change did not run. A deleted account accepts no edits, no restore, and no password reset.",
  "@adminProfileDeletedNotice": {"description": "2015 在三條既有寫入通路（改名／停用恢復／重置）上的一句：目標不再接受任何寫入，處置不是重試。"},
  "adminProfileDeletedBanner": "This administrator has been deleted.",
  "@adminProfileDeletedBanner": {"description": "已刪除橫幅（合同欄位缺刪除時刻時的兜底句，正常路徑用下一條）。"},
  "adminProfileDeletedBannerAt": "This administrator was deleted at {at}.",
  "@adminProfileDeletedBannerAt": {"description": "已刪除橫幅：刪除時刻取自服務端回傳的現值，界面不自算。", "placeholders": {"at": {"type": "String"}}},
  "adminProfileIdentityKeptHint": "The account and its login name are kept so past actions still resolve to the same identity; the display name shown here is the anonymized placeholder. There is no way back from this state.",
  "@adminProfileIdentityKeptHint": {"description": "「為什麼人還留在目錄裡」的一句：行與登入名保留、顯示名已是佔位值、且沒有恢復通路。"},
  "adminDeleteAction": "Delete this administrator",
  "@adminDeleteAction": {"description": "刪除按鈕（從不直達：會先開確認對話框）。"},
  "adminDeleteWorkingHint": "Deleting...",
  "@adminDeleteWorkingHint": {"description": "刪除提交中的按鈕文字。"},
  "adminDeleteZoneHint": "Deleting ends sign-in for good. It is a different thing from disabling, and nothing here brings the account back.",
  "@adminDeleteZoneHint": {"description": "刪除區的一句前置說明：點名它與停用的差別在「沒有回去的路」。"},
  "adminDeleteConfirmTitle": "Delete this administrator?",
  "@adminDeleteConfirmTitle": {"description": "刪除確認對話框標題。"},
  "adminDeleteConfirmBody": "Target: {loginName}. New sign-ins will be rejected, every active session is signed out immediately, and the display name becomes an anonymized placeholder. This is not disabling: a deleted account cannot be restored to sign-in, and no endpoint brings it back. The record and its login name stay in place, so existing audit entries and every other real reference keep pointing to the same identity — and that login name cannot be taken by anyone else.",
  "@adminDeleteConfirmBody": {"description": "刪除確認文：目標、三件效果、兩件不會發生（不是停用、沒有恢復通路）與「為什麼留行」一次讀完，提交前的唯一依據。", "placeholders": {"loginName": {"type": "String"}}},
  "adminDeleteConfirmOkAction": "Confirm delete",
  "@adminDeleteConfirmOkAction": {"description": "刪除確認對話框的肯定按鈕。"},
  "adminDeleteSuccessNotice": "Deleted. {count, plural, =0 {No active session needed to sign out.} other {{count} session(s) were signed out and must sign in again.}}",
  "@adminDeleteSuccessNotice": {"description": "刪除成功句：撤銷數量取自 DELETE 回應，不許界面自己猜。", "placeholders": {"count": {"type": "int"}}},
  "adminDeleteAlreadyNotice": "This administrator is already deleted, so nothing happened: no extra revocation and no second audit entry.",
  "@adminDeleteAlreadyNotice": {"description": "重複刪除的一句（2015 打在刪除入口上）：一個字都沒寫，因此也不該說成「又刪了一次」。"},
  "adminDeleteNoFieldNotice": "Deleting takes no fields: the target is in the address and the body carries nothing.",
  "@adminDeleteNoFieldNotice": {"description": "1004 的一句：刪除不帶任何欄位，會走到這裡代表本體塞了東西。"},
  "adminProfileStaleRejectedNotice": "This session has expired or must change its password first; sign in again, then retry.",
  "@adminProfileStaleRejectedNotice": {"description": "2003／2007／2010 會話類失敗的一句處置。"},
  "adminProfileUnavailableNotice": "The server did not accept this save, and nothing was written. Details are in the local diagnostic log.",
  "@adminProfileUnavailableNotice": {"description": "其餘保存失敗的一句：明確沒有任何寫入。"},
  "adminProfileReloadAction": "Reload this record",
  "@adminProfileReloadAction": {"description": "衝突後重讀詳情按鈕。"},
  "accountPolicyTitle": "Server account-creation policy",
  "@accountPolicyTitle": {"description": "Root 策略卡的區塊標題。"},
  "accountPolicyIntro": "Three values describe how this server intends to add ordinary sign-ins. Only Root can read or change them, and the server, not this screen, decides what they allow.",
  "@accountPolicyIntro": {"description": "卡片導語：策略屬伺服器，介面只轉述。"},
  "accountPolicyAdminCreateLabel": "Administrators may create ordinary accounts",
  "@accountPolicyAdminCreateLabel": {"description": "第一個開關的標籤。"},
  "accountPolicyAdminCreateHint": "This switch is about administrators creating ordinary accounts. It never applies to Root creating administrators, or to the host-local commands that set or recover the Root credential.",
  "@accountPolicyAdminCreateHint": {"description": "開關說明：例外要講在介面上。"},
  "accountPolicySelfRegisterLabel": "Self-registration mode",
  "@accountPolicySelfRegisterLabel": {"description": "模式區塊標籤。"},
  "accountPolicyModeClosedLabel": "Closed",
  "@accountPolicyModeClosedLabel": {"description": "closed 選項。"},
  "accountPolicyModeOpenLabel": "Open",
  "@accountPolicyModeOpenLabel": {"description": "open 選項。"},
  "accountPolicyModeExternalNotice": "The server currently records \"{mode}\", a mode this version cannot select. Saving will replace it with one of the choices above; nothing here is filled in on your behalf.",
  "@accountPolicyModeExternalNotice": {"description": "現值是未開放或未知模式時的如實說明，不預填。", "placeholders": {"mode": {"type": "String"}}},
  "accountPolicyGuestLabel": "Guest (temporary) accounts may be created",
  "@accountPolicyGuestLabel": {"description": "第三個開關的標籤。"},
  "accountPolicyGuestHint": "Guests carry no server-side role; turning this on would only ever open the temporary sign-in path.",
  "@accountPolicyGuestHint": {"description": "訪客不持有角色這句話。"},
  "accountPolicyUpdatedNeverLabel": "Never changed since the server was installed",
  "@accountPolicyUpdatedNeverLabel": {"description": "updated_at 缺席時的句子：零值是一個事實。"},
  "accountPolicyUpdatedOnLabel": "Last changed: {time}",
  "@accountPolicyUpdatedOnLabel": {"description": "最後修改時刻，值取自服務端回應。", "placeholders": {"time": {"type": "String"}}},
  "accountPolicyEntryLabel": "What an unsigned-in browser can see right now: sign-up {signUp}, guest {guest}",
  "@accountPolicyEntryLabel": {"description": "對外入口現值，取自服務端合成。", "placeholders": {"signUp": {"type": "String"}, "guest": {"type": "String"}}},
  "accountPolicyOpenWord": "open",
  "@accountPolicyOpenWord": {"description": "對外答案為真時的詞。"},
  "accountPolicyClosedWord": "closed",
  "@accountPolicyClosedWord": {"description": "對外答案為假時的詞。"},
  "accountPolicyCapabilityNote": "A saved value is an intention, not a working path. Administrator-created ordinary accounts, self-registration and guest entry now all exist as paths, so the switch and the mode are what gate them. The guest switch also opens only the temporary sign-in road: the person who comes in carries no password, belongs to no activity, and gains no administrator entry from it. The approval mode opens the door for applications only - approving or declining anyone is not something this card can do.",
  "@accountPolicyCapabilityNote": {"description": "策略值不等於能力。"},
  "accountPolicySaveAction": "Save policy",
  "@accountPolicySaveAction": {"description": "保存按鈕。"},
  "accountPolicySavedNotice": "Saved. The response carries the values the server now holds.",
  "@accountPolicySavedNotice": {"description": "保存成功摘要：現值來自回應。"},
  "accountPolicyConfirmTitle": "Change the server's account-creation policy?",
  "@accountPolicyConfirmTitle": {"description": "確認對話框標題。"},
  "accountPolicyConfirmBody": "This writes all three values at once and leaves one Root audit record. What the values still do not do: the guest switch opens only a password-less account that belongs to no activity - it does not hand anybody an administrator entry, and it does not create an identity anyone can sign back into later; nothing here approves anybody either - applications filed while the mode is approval keep waiting for an approval screen this version does not have. Administrator-created ordinary accounts is a working path and this switch opens or closes it; self-registration is also a working path, where open mode creates an account that can sign in at once and approval mode creates one that cannot. Root's own ways in - creating administrators and the host-local credential commands - are not affected by these switches.",
  "@accountPolicyConfirmBody": {"description": "確認對話框內文：講完效果與兩件不會發生的事。"},
  "accountPolicyConfirmOk": "Save",
  "@accountPolicyConfirmOk": {"description": "確認對話框肯定按鈕。"},
  "accountPolicyConfirmCancel": "Cancel",
  "@accountPolicyConfirmCancel": {"description": "確認對話框取消按鈕：取消不發任何請求。"},
  "accountPolicyLoadingNotice": "Reading the current policy...",
  "@accountPolicyLoadingNotice": {"description": "載入中。"},
  "accountPolicyLoadFailedNotice": "The policy could not be read. Nothing on this screen has been changed.",
  "@accountPolicyLoadFailedNotice": {"description": "讀取失敗：不顯示任何猜測值。"},
  "accountPolicyDeniedNotice": "Your session is not Root, so this policy cannot be read or changed here.",
  "@accountPolicyDeniedNotice": {"description": "2011 的一句。"},
  "accountPolicyStaleRejectedNotice": "The current session is invalid or a first password change is required; sign in again and try once more.",
  "@accountPolicyStaleRejectedNotice": {"description": "2002／2003／2007／2010 收斂的一句。"},
  "accountPolicyNotFoundNotice": "This server does not expose the account-creation policy endpoint, so nothing was read or changed.",
  "@accountPolicyNotFoundNotice": {"description": "1001 的一句。"},
  "accountPolicyReloadAction": "Read the policy again",
  "@accountPolicyReloadAction": {"description": "重讀出口。"},
  "accountPolicyModeRejectedNotice": "That mode is a recognised name, but its flow has not shipped in this server version, so it cannot be selected yet.",
  "@accountPolicyModeRejectedNotice": {"description": "2016 在卡內的一句（與 1004 分開）。"},
  "errorCodeAccountPolicyModeUnavailable": "This self-registration mode is recognised but its flow has not shipped in this server version, so the policy will not record it.",
  "@errorCodeAccountPolicyModeUnavailable": {"description": "機器碼 2016（與後端 locale.go 同一語意）。"},
  "errorCodeAccountCreationDisabled": "The server's account-creation policy does not open this path right now. Your permissions are fine; ask Root to turn the matching switch on, then try again.",
  "@errorCodeAccountCreationDisabled": {"description": "機器碼 2017（與後端 locale.go 同一語意）：策略未開放，處置是請 Root 開關而不是換身分。"},
  "errorCodeGuestUpgradeRequired": "The target is a guest account with no general password to reset. This is not a permissions or formatting problem; the guest upgrade path has to ship first.",
  "@errorCodeGuestUpgradeRequired": {"description": "機器碼 2018（與後端 locale.go 同一語意）：訪客沒有憑據可重置，處置是等升級通路。"},
  "errorCodeSelfRegisterNameTaken": "This login name is already taken (matching absorbs case and width variants such as full-width letters), so this sign-up created no account. Choose another name and submit again.",
  "@errorCodeSelfRegisterNameTaken": {"description": "機器碼 2019（與後端 locale.go 同一語意）：匿名自註冊的重名，處置與 2012 同形（換名字），但出現在門外的註冊入口而非需已認證主體的建號路。"},
  "registerTitle": "Create a standard account",
  "@registerTitle": {"description": "自註冊頁在應用殼標題列的名稱：說的是這一頁在做什麼，與入口卡的按鈕文字分開。"},
  "registerSummary": "Fill in a login name, a display name and a password of your own. Whether this server accepts the submission at all is decided by the account-creation policy it reads at the moment you submit, so this open form promises nothing. Submitting never signs you in by itself, and whether the account is usable straight away or is queued for an administrator's approval is also decided there - the next card reports whatever the server actually answered.",
  "@registerSummary": {"description": "自註冊頁說明：三欄皆自填、准入由後端提交時現讀策略決定、提交本身不自動登入；能否立刻使用或須等審批，由提交後的伺服器答案說。"},
  "registerLoginNameLabel": "Login name",
  "@registerLoginNameLabel": {"description": "登入名輸入框標籤。"},
  "registerDisplayNameLabel": "Display name",
  "@registerDisplayNameLabel": {"description": "顯示名輸入框標籤。"},
  "registerPasswordLabel": "Password",
  "@registerPasswordLabel": {"description": "自選口令輸入框標籤。"},
  "registerPasswordHint": "This is the password you will sign in with, so pick one you can keep; if this server requires approval, it is this password that signs you in once the application is approved. Login-name and password rules belong to the server, which names the field when something does not meet them.",
  "@registerPasswordHint": {"description": "口令輸入框輔助文字：點明這是自選、日後登入要用的口令（若須審批，批准那一刻生效的也是它），規則由後端把關並會點名欄位。"},
  "registerInviteCodeLabel": "Invite code",
  "@registerInviteCodeLabel": {"description": "邀請碼輸入框標籤，只在伺服器要求憑邀請碼註冊（invite 模式）時出現。"},
  "registerInviteCodeHint": "This server signs people up with an invite code. Paste the code you were given; it is only sent in this request, never kept in the page, the address bar, the browser history or the logs.",
  "@registerInviteCodeHint": {"description": "邀請碼輸入框輔助文字：說明這一趟要帶發碼人給的那枚碼，且它只在這次請求裡存在、不入 URL／歷史／日誌。"},
  "registerSubmitAction": "Submit",
  "@registerSubmitAction": {"description": "提交按鈕：動詞中立，同時涵蓋「建立帳戶」與「提交申請」。"},
  "registerSubmitting": "Submitting…",
  "@registerSubmitting": {"description": "進行中的按鈕文字，與 registerSubmitAction 同一動詞。"},
  "registerFormIncompleteNotice": "Enter a login name, a display name and a password before submitting.",
  "@registerFormIncompleteNotice": {"description": "本地非空檢查與無法歸類欄位時的後備提示。"},
  "registerInvalidLoginNameNotice": "The server rejected this login name: it does not meet the login-name rules (length, allowed characters, or spacing). Adjust it and submit again.",
  "@registerInvalidLoginNameNotice": {"description": "1004 點名 login_name 時的一句。"},
  "registerInvalidDisplayNameNotice": "The server rejected this display name: it does not meet the display-name rules. Adjust it and submit again.",
  "@registerInvalidDisplayNameNotice": {"description": "1004 點名 display_name 時的一句。"},
  "registerInvalidPasswordNotice": "The server rejected this password: it does not meet the password rules. Choose another one and submit again.",
  "@registerInvalidPasswordNotice": {"description": "1004 點名 password 時的一句。"},
  "registerCreatedTitle": "Account {loginName} was created.",
  "@registerCreatedTitle": {"description": "註冊成功摘要標題：點名伺服器回傳的登入名原值。", "placeholders": {"loginName": {"type": "String"}}},
  "registerUsableNowNote": "Nothing else is required: sign in now with the password you just chose.",
  "@registerUsableNowNote": {"description": "must_change_password 為假（自註冊恆如此）時的一句：口令自選、立刻可登入。"},
  "registerNoActivityNotice": "This is only an account for now: no activity profile, no assets, and no seat on any roster. Signing in is everything it can do today.",
  "@registerNoActivityNotice": {"description": "「已建立」不等於「已加入活動」：把空狀態如實講在第一線。"},
  "registerGoSignInAction": "Go to sign in",
  "@registerGoSignInAction": {"description": "成功摘要裡的下一步按鈕：把人送到既有登入頁，這一頁不簽發會話。"},
  "registerEntryTitle": "Self-registration",
  "@registerEntryTitle": {"description": "入口層自註冊卡的標題。"},
  "registerEntryCheckingHint": "Checking whether this server accepts self-registration…",
  "@registerEntryCheckingHint": {"description": "讀入口能力進行中的中性提示。"},
  "registerEntryClosedHint": "This server is not accepting self-registration right now, so there is nothing to open here. If it is switched on later, the option to create an account appears at this spot.",
  "@registerEntryClosedHint": {"description": "sign_up_open 為假：不顯示出口，如實說此刻關閉。"},
  "registerEntryCheckFailedHint": "The server could not be reached to check whether self-registration is open, so no sign-up option is shown. Use Re-check once the connection is back.",
  "@registerEntryCheckFailedHint": {"description": "查不到准入狀態：降級為「收」，不把『查不了』說成開放、也不替伺服器編一個它沒做過的關閉決定。"},
  "registerEntryOpenHint": "This server reports that it accepts account submissions. Opening the form is not a guarantee: the server decides again at the moment you submit, and whether you can sign in straight away or have to wait for approval is decided there too.",
  "@registerEntryOpenHint": {"description": "sign_up_open 為真：露出出口，同時點明這不是准入保證，立即能用或等待審批都由提交時決定。"},
  "registerEntryAction": "Create or apply for an account",
  "@registerEntryAction": {"description": "入口卡打開註冊頁的按鈕文字（純導航，放行仍由後端判定；動詞涵蓋建立與申請）。"},
  "registerEntryRecheckAction": "Re-check",
  "@registerEntryRecheckAction": {"description": "重新查一次入口能力的按鈕文字。"},
  "registerPendingTitle": "Application {loginName} was submitted.",
  "@registerPendingTitle": {"description": "待審批提交成功的標題：點名伺服器回傳的登入名原值。", "placeholders": {"loginName": {"type": "String"}}},
  "applicationStatusQueryAction": "Check status",
  "@applicationStatusQueryAction": {"description": "送出一次憑據查詢的按鈕文字。"},
  "applicationStatusQuerying": "Checking…",
  "@applicationStatusQuerying": {"description": "查詢進行中的按鈕文字（進行中停用，防連點產生多趟請求）。"},
  "errorCodeNotAnApplication": "These credentials are valid, but this account is not an application awaiting approval; it took effect directly through open sign-up, an administrator, or Root. Please use the sign-in page.",
  "registerPendingNote": "This server requires an administrator to approve the application, so this account cannot be signed in to yet. The password you chose has been saved: once the application is approved, that same password is what signs you in.",
  "registerCheckStatusAction": "Check my application status",
  "applicationStatusTitle": "My application status",
  "applicationStatusSummary": "Type the login name and the password you used when you applied. This is not a sign-in and it saves nothing: every lookup re-checks those credentials, and reloading or leaving this page leaves behind nothing that could be reused.",
  "applicationStatusLoginNameLabel": "Login name",
  "applicationStatusPasswordLabel": "Password",
  "applicationStatusIncompleteNotice": "Enter a login name and a password before checking.",
  "applicationStatusPendingNote": "Still waiting for approval: nobody has made a decision yet, so this account cannot sign in.",
  "applicationStatusApprovedNote": "Approved: use the ordinary sign-in page with the password you chose. Approval grants the ability to sign in and nothing else - no role and no activity.",
  "applicationStatusRejectedNote": "Declined: this application was rejected, so the account cannot sign in. This page shows no reason for the decision.",
  "applicationStatusUnknownNote": "The server reported an outcome this version of the app does not recognise, so nothing is guessed about it.",
  "applicationStatusSubmittedLabel": "Submitted at",
  "applicationStatusDecidedLabel": "Decided at",
  "accountPolicyModeApprovalLabel": "Approval required",
  "accountPolicyApprovalHint": "In this mode the form still takes the person's own password, but what lands is an application that cannot sign in until somebody with server-level administration rights approves it. Approving and declining live on the administrator page, and they only ever produce an ordinary account with no server role. Switching the mode later changes nothing about applications already filed.",
  "accountPolicyModeInviteLabel": "Invite code required",
  "@accountPolicyModeInviteLabel": {"description": "自註冊模式 invite 選項的標籤。"},
  "accountPolicyInviteHint": "In this mode only a person holding a valid invite code can sign up on their own. The code is redeemed once for each account it creates and grants no server role — what lands is an ordinary account that can sign in right away, on the same sign-in path as open mode. Issuing and revoking invite codes lives on the registration-invite-code page. Switching the mode later changes nothing about accounts already created.",
  "@accountPolicyInviteHint": {"description": "invite 模式說明：只有持有效邀請碼者可自行註冊、碼按帳戶逐次核銷且不帶角色、換出的是可立即登入的普通帳戶（與開放模式同路）、簽發撤銷在邀請碼那張卡、切模式不動已建帳戶。"},
  "@errorCodeNotAnApplication": {"description": "機器碼 2020：憑據已證明身分但該帳戶不經審批通路，處置是改用登入入口。"},
  "@registerPendingNote": {"description": "待審批的核心句：申請已落地但尚未獲准登入；口令已儲存、批准後即用。"},
  "@registerCheckStatusAction": {"description": "待審批摘要唯一的出口按鈕：通往本人狀態查詢頁（那條通路不簽發會話）。"},
  "@applicationStatusTitle": {"description": "本人申請狀態頁在應用殼標題列與結果卡上的名稱。"},
  "@applicationStatusSummary": {"description": "狀態頁摘要：說清「這不是登入、每次重新驗證憑據、重新整理即不剩東西」。"},
  "@applicationStatusLoginNameLabel": {"description": "狀態頁登入名欄標籤。"},
  "@applicationStatusPasswordLabel": {"description": "狀態頁口令欄標籤（遮蔽輸入）。"},
  "@applicationStatusIncompleteNotice": {"description": "本地非空檢查：兩欄缺一不發請求。"},
  "@applicationStatusPendingNote": {"description": "pending 的結局句：如實說還在等、不能登入，不拿等待冒充已啟用。"},
  "@applicationStatusApprovedNote": {"description": "approved 的結局句：導向既有登入通路，並明說批准不附帶角色。"},
  "@applicationStatusRejectedNote": {"description": "rejected 的結局句：理由今日根本不存在——內部備註與可公開說法都由用戶決定為不落庫，審核人只存在伺服器端審計裡。"},
  "@applicationStatusUnknownNote": {"description": "合同日後多一種結局時的誠實句：不猜成等待也不猜成批准。"},
  "@applicationStatusSubmittedLabel": {"description": "與 labelValuePair 組合成「提交時刻：…」一行。"},
  "@applicationStatusDecidedLabel": {"description": "決定時刻只在已有決定時出現；缺席時界面不擺這一行的空值。"},
  "@accountPolicyModeApprovalLabel": {"description": "自註冊模式 approval 選項的標籤。"},
  "@accountPolicyApprovalHint": {"description": "approval 模式說明：收申請、由具備管理權者批准或拒絕，批准造不出角色，切模式不動歷史。"},
  "errorCodeApplicationDecided": "This registration has already been decided, so your review did not take effect. Read the application list again: approved accounts are handled in the standard account directory, and a declined application cannot be reversed.",
  "@errorCodeApplicationDecided": {"description": "機器碼 2021：這份申請已有決定，本次審批整個沒有發生；處置是重讀名冊，而不是把那顆按鈕再點一次。"},
  "registrationReviewTitle": "Registration applications",
  "@registrationReviewTitle": {"description": "管理員端「註冊申請名冊」卡的標題。"},
  "registrationReviewScopeHint": "This list holds the applications that came through the approval path: those still waiting and those already declined. Someone who was approved is no longer listed here - they belong to the standard account directory now. Approving grants one thing only, the ability to sign in: no server-level role, and this action issues no session, so that person still has to sign in themselves with the password they chose.",
  "@registrationReviewScopeHint": {"description": "影響範圍常駐句：說清兩本名冊的分工，批准只給登入能力、不簽會話、不給角色。"},
  "registrationReviewFilterPending": "Awaiting a decision",
