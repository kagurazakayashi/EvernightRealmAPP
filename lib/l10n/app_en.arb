  "guestEntryTitle": "Temporary guest entry",
  "@guestEntryTitle": {"description": "入口層訪客卡的標題。"},
  "guestEntryRecheckAction": "Re-check",
  "@guestEntryRecheckAction": {"description": "重新查一次訪客入口能力的按鈕文字。"},
  "guestEntryCheckingHint": "Checking whether this server allows guest entry…",
  "@guestEntryCheckingHint": {"description": "讀入口能力進行中的中性提示。"},
  "guestEntryClosedHint": "This server is not allowing guests right now, so there is nothing to open here. If it is switched on later, the entry option appears at this spot.",
  "@guestEntryClosedHint": {"description": "guest_open 為假：不顯示出口，如實說此刻關閉。"},
  "guestEntryCheckFailedHint": "The server could not be reached to check whether guest entry is open, so no entry option is shown. Use Re-check once the connection is back.",
  "@guestEntryCheckFailedHint": {"description": "查不到准入狀態：降級為「收」，不把『查不了』說成開放，也不替伺服器編一個它沒做過的關閉決定。"},
  "guestEntryOpenHint": "This server reports that it allows temporary guest entry. Seeing the option is not a guarantee: the server decides again at the moment you press it.",
  "@guestEntryOpenHint": {"description": "guest_open 為真：露出出口，同時點明這不是准入保證。"},
  "guestEntryLimitsNote": "This is a temporary identity: the server names the account, and what you get is a password-less guest account plus this one session. It belongs to no activity and cannot do what administrators and Root can do. When the session expires, you sign out, you change device, or this machine's credential is cleared, this visit ends - the nickname is not a credential, and there is no road back with it. If anything has to be done about this account, an administrator verifies it in the ordinary account directory and decides there. Nothing is created until you press Enter yourself: loading the page, refreshing and reconnecting never write.",
  "@guestEntryLimitsNote": {"description": "按下去之前講完的四件事：臨時身分、無憑據、不屬於任何活動、失去會話後不自助找回；外加「只有主動按才寫庫」這條界線。"},
  "guestEntryNicknameLabel": "Nickname (optional)",
  "@guestEntryNicknameLabel": {"description": "暱稱輸入框標籤——明示可選，不是必填門檻。"},
  "guestEntryNicknameHint": "Shown only; it may duplicate somebody else's name. It is not a password and cannot be used to recover this visit.",
  "@guestEntryNicknameHint": {"description": "暱稱不是憑據這句話，必須在輸入框旁邊就講清楚。"},
  "guestEntryAction": "Enter as a guest",
  "@guestEntryAction": {"description": "唯一會寫庫的那顆按鈕：動詞是「進入」而不是「建立帳戶」，因為他要的是這一次身分。"},
  "guestEntrySubmitting": "Entering…",
  "@guestEntrySubmitting": {"description": "進入請求進行中的按鈕文字（同時停用，防連點多出帳戶）。"},
  "guestEntryAddressChangedHint": "The server address changed while this entry request was in flight, so its result was discarded: that reply describes a different server. Re-check the entry and try again.",
  "@guestEntryAddressChangedHint": {"description": "請求飛行中位址被換掉：結果如實丟棄的那一句，與登入同一取向。"},
  "guestEntryMissingCredentialNote": "The server accepted this entry, but this client could not obtain a session credential to send back, so the state stays undetermined instead of claiming you are in. Check the device environment and re-check the entry.",
  "@guestEntryMissingCredentialNote": {"description": "原生端取不到可回傳憑據：狀態停在無法確定，不謊報已進入。"},
  "sessionSubjectGuest": "Guest (temporary identity)",
  "@sessionSubjectGuest": {"description": "伺服器回報 account_type=guest 時的身份行；值取自回應，不是本地推測。"},
  "sessionGuestNotice": "This is a temporary identity: there is no password for you to change, and you belong to no activity. Which entries on this server open is decided by the identity the server reports. Use Sign out to end this visit; afterwards there is no way back with the nickname, and an administrator has to verify the account first.",
  "@sessionGuestNotice": {"description": "已登入的訪客在摘要卡上看到的那句：為什麼沒有改密入口、結束後怎麼辦。"}
