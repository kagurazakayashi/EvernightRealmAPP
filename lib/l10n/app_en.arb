  "inviteCodeIssuedCodeLabel": "{code}",
  "@inviteCodeIssuedCodeLabel": {"description": "一次性明文碼的受控展示格（純佔位，無剪貼板、無二維碼）。", "placeholders": {"code": {"type": "String"}}},
  "inviteCodeIssuedOneTimeHint": "This page does not copy or share the code, and shows no QR. Select and write it down yourself; once you leave, the only way to get a code again is to issue a new one.",
  "@inviteCodeIssuedOneTimeHint": {"description": "受控一次性展示旁邊的說明：無剪貼板、無二維碼、丟失只能重簽。"},
  "inviteCodeIssuedDoneAction": "I've noted the code",
  "@inviteCodeIssuedDoneAction": {"description": "收起一次性展示的按鈕（收起後那枚碼就再也看不到）。"},
  "inviteCodeRevokeAction": "Revoke",
  "@inviteCodeRevokeAction": {"description": "行上的撤銷鈕（只對尚未撤銷的目標出現）。"},
  "inviteCodeRevokeConfirmTitle": "Revoke this invite code?",
  "@inviteCodeRevokeConfirmTitle": {"description": "撤銷確認框標題。"},
  "inviteCodeRevokeConfirmBody": "You are about to revoke the invite code “{label}”. It immediately blocks any new redemption of this code, and this is one-way — it can't be reactivated. It does not undo any account already created, revoke any session, or erase how many times the code was used. This is not a delete: the row stays on the roster as history.",
  "@inviteCodeRevokeConfirmBody": {"description": "撤銷確認框：講完立刻擋新核銷、單向、四件不发生（含“不是刪除”）。", "placeholders": {"label": {"type": "String"}}},
  "inviteCodeRevokeConfirmOkAction": "Revoke",
  "@inviteCodeRevokeConfirmOkAction": {"description": "撤銷確認框肯定鈕。"},
  "inviteCodeRevokeConfirmCancelAction": "Cancel",
  "@inviteCodeRevokeConfirmCancelAction": {"description": "撤銷確認框取消鈕。"},
  "inviteCodeRevokedNotice": "Revoked the invite code “{label}”. No session was touched and no account was changed — only this code stops being redeemable.",
  "@inviteCodeRevokedNotice": {"description": "撤銷成功句：明說不動會話／帳戶，只是這枚碼停了。", "placeholders": {"label": {"type": "String"}}},
  "inviteCodeAlreadyRevokedNotice": "This code was already revoked (by you or by someone else). Reload the roster — the revoke button is gone for it.",
