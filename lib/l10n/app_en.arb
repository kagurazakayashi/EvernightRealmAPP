  "registrationReviewAlreadyRejectedNotice": "This application has already been declined. This version has no way to reverse a decision, and that login name stays taken.",
  "@registrationReviewAlreadyRejectedNotice": {"description": "已被拒絕的那一行不擺按鈕，只給這一句實話（決定單向、名字仍被佔住）。"},
  "registrationReviewUnknownStatusNotice": "The server reported a status this version does not recognise ({status}), so no action button is offered for it.",
  "@registrationReviewUnknownStatusNotice": {"description": "表外狀態的誠實句：不猜成「還在等」也不猜成「已批准」，更不擺一顆註定落敗的按鈕。", "placeholders": {"status": {"type": "String"}}},
  "registrationReviewConfirmTitleApprove": "Approve this application",
  "@registrationReviewConfirmTitleApprove": {"description": "批准確認對話框的標題。"},
  "registrationReviewConfirmTitleReject": "Decline this application",
  "@registrationReviewConfirmTitleReject": {"description": "拒絕確認對話框的標題。"},
  "registrationReviewConfirmBodyApprove": "You are about to approve the application from {loginName}. From that moment the account can sign in with the password its owner chose, with no server-level role, and this action issues no session - signing in remains something only that person can do. This is not lifting a suspension, not a rename and not a delete, and this version cannot reverse the decision afterwards.",
  "@registrationReviewConfirmBodyApprove": {"description": "批准確認句：點名目標、講完落下什麼與四件不會發生的事（含決定單向）。", "placeholders": {"loginName": {"type": "String"}}},
  "registrationReviewConfirmBodyReject": "You are about to decline the application from {loginName}. The row and the login name stay in the database, so nobody else can take that name and this person cannot file again under it; the application stays on this list as declined. No reason is stored and none is passed on - that person can only re-prove their own credentials and see that the decision was to decline. This decision cannot be reversed in this version.",
  "@registrationReviewConfirmBodyReject": {"description": "拒絕確認句：點名目標、講完保留策略（行與名字仍佔用）、理由不落庫也不轉述、決定單向。", "placeholders": {"loginName": {"type": "String"}}},
  "registrationReviewConfirmCancelAction": "Cancel",
  "@registrationReviewConfirmCancelAction": {"description": "確認對話框的取消鈕：取消是一條正經出路，一請求都不發。"},
  "registrationReviewConfirmOkApproveAction": "Approve",
  "@registrationReviewConfirmOkApproveAction": {"description": "確認對話框裡的批准鈕（按下才發出 PUT）。"},
  "registrationReviewConfirmOkRejectAction": "Decline",
  "@registrationReviewConfirmOkRejectAction": {"description": "確認對話框裡的拒絕鈕（按下才發出 PUT）。"},
  "registrationReviewApprovedNotice": "Approved: {loginName} can now sign in with the password they chose. This page did not sign them in and sends them no notice - this server has no notification module yet.",
  "@registrationReviewApprovedNotice": {"description": "批准成功句：主詞取 PUT 回應，並明說沒有通知模組（不宣稱已推送）。", "placeholders": {"loginName": {"type": "String"}}},
  "registrationReviewRejectedNotice": "Declined: the application from {loginName} is recorded as declined and that login name stays taken. The person still cannot sign in, and no reason is stored or shown.",
  "@registrationReviewRejectedNotice": {"description": "拒絕成功句：如實講保留策略與「無理由可顯示」，不承諾任何後續通知。", "placeholders": {"loginName": {"type": "String"}}},
  "registrationReviewDecidedNotice": "This application has already been decided - your action did not happen and did not overwrite the earlier decision. Read the list again to see the server's current truth.",
  "@registrationReviewDecidedNotice": {"description": "2021 那一句：衝突不覆蓋先前決定，出口只有重讀名冊（不擺「再點一次」）。"},
  "registrationReviewGoneNotice": "That application is not in this list: it either never was, or the account it belongs to is outside this book's scope. Choose another target.",
  "@registrationReviewGoneNotice": {"description": "1001 那一句：處置是換目標，與「已有決定」「沒有權限」都不同形。"},
  "registrationReviewDeniedNotice": "This session has no server-level administration rights, so it can neither read the application list nor decide about anyone.",
  "@registrationReviewDeniedNotice": {"description": "2011 那一句：身分可信但沒有這個權限，不暗示「重登就有」（那是另一句）。"},
  "registrationReviewReloadAction": "Read the list again",
  "@registrationReviewReloadAction": {"description": "2021 之後唯一的出口按鈕：重讀名冊（不是把決定再發一次）。"},
  "errorCodeInviteAlreadyRevoked": "This invite code has already been revoked, so this revocation did not take effect. Revocation is one-way: reload the invite-code roster. A revoked code cannot be reactivated or redeemed, and pressing again will not rewrite the earlier revocation.",
  "@errorCodeInviteAlreadyRevoked": {"description": "機器碼 2022：這枚邀請碼已被撤銷，本次撤銷整個沒有發生；處置是重讀名冊，而不是把那顆按鈕再點一次。"},
  "errorCodeInviteCodeRejected": "This server signs people up with a valid invite code, and the code you used this time cannot create an account — it may be missing, malformed, expired or revoked, fully used, or just consumed by another sign-up. For safety the server does not say which. Ask whoever issues invite codes for a fresh valid one and submit again; another login name, rewording this field, or signing in again will not change that.",
  "@errorCodeInviteCodeRejected": {"description": "機器碼 2023：invite 模式下這枚邀請碼換不出一筆帳戶（缺／壞／過期／撤銷／用盡／併發落敗一律同形，不泄露差的是哪一半）；處置是去要一枚新的有效碼，而不是改寫法或換名字。"},
