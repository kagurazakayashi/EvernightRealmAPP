  "stdAccountProfileTitle": "Account: {loginName}",
  "@stdAccountProfileTitle": {"description": "詳情／編輯卡標題：點名的是詳情換回的登入名。", "placeholders": {"loginName": {"type": "String"}}},
  "stdAccountProfileNotFoundNotice": "This account is not in the standard account directory: it may be an administrator or Root, or it has already been deleted.",
  "@stdAccountProfileNotFoundNotice": {"description": "1001 那一句：目標不在這本目錄（可能是管理員、Root 或已被刪除），後端刻意不區分這三種。"},
  "stdAccountProfileDeniedNotice": "This session has no server-level administration rights: the account directory and profile edit are open to administrators only.",
  "@stdAccountProfileDeniedNotice": {"description": "2011 那一句：主體沒有伺服器級管理權，目錄與資料編輯都不開放。"},
  "stdAccountProfileSecurityHint": "Credentials, server roles and the first-change flag are not edited on this form - the login name, password and flags stay exactly as the server holds them. Turning the login ability itself on and off lives in the disable/restore section below, and the password has its own reset section under that; both ask for their own confirmation.",
  "@stdAccountProfileSecurityHint": {"description": "資料表單的邊界句：憑證、權限與安全狀態不在這一頁修改，介面也不擺那些控制項。"},
  "stdAccountProfileNoSectionsNotice": "Activities, assets and messages are not implemented on this server, so this record shows none of them; nothing here is padded with placeholders.",
  "@stdAccountProfileNoSectionsNotice": {"description": "未實作模組如實缺席：活動、資產與訊息不拿佔位值冒充。"},
  "stdAccountProfileMissingAnchorNotice": "The form lost the current value it was based on. Reload this record before saving again.",
  "@stdAccountProfileMissingAnchorNotice": {"description": "1004 點名 expected_display_name：依據值遺失時要重讀而非再撞一次。"},
  "stdAccountStatusScopeHint": "Disabling or restoring login here affects this account across the whole server: every one of its current sessions, on every device and in every activity, is revoked, and future logins are refused. It is not a mute, a transfer freeze or a faction restriction inside one activity.",
  "@stdAccountStatusScopeHint": {"description": "影響範圍句：動的是伺服器級登入能力（所有裝置、所有活動），不是活動內的限制。"},
  "stdAccountStatusConfirmTitleDisable": "Disable logins for this account?",
  "@stdAccountStatusConfirmTitleDisable": {"description": "停用確認對話框標題（主語是普通帳戶，與管理員那組各成一句）。"},
  "stdAccountStatusConfirmTitleRestore": "Restore logins for this account?",
  "@stdAccountStatusConfirmTitleRestore": {"description": "恢復確認對話框標題。"},
  "stdAccountStatusConfirmDisableBody": "Target: {loginName}. New logins will be refused and every current session of this account - on each device and in each activity - will be revoked, so those people have to log in again. This is not a deletion: the account, its login name and every record stay as they are, and logins can be restored later.",
  "@stdAccountStatusConfirmDisableBody": {"description": "停用確認文：目標、跨裝置跨活動的影響與「這不是刪除」一次讀完，是提交前唯一的依據。", "placeholders": {"loginName": {"type": "String"}}},
  "stdAccountStatusConfirmRestoreBody": "Target: {loginName}. This restores only the ability to log in again: sessions revoked while the account was disabled stay revoked and will not come back, and an unfinished first password change still applies. A deleted account cannot be restored this way.",
  "@stdAccountStatusConfirmRestoreBody": {"description": "恢復確認文：只恢復新登入資格——舊會話不復活、首次改密義務不解除、刪除態不可恢復。", "placeholders": {"loginName": {"type": "String"}}},
  "stdAccountStatusDisabledNotice": "Disabled. {count, plural, =0 {There was no active session to log out.} one {{count} session was logged out and has to sign in again.} other {{count} sessions were logged out and have to sign in again.}}",
  "@stdAccountStatusDisabledNotice": {"description": "停用成功句：撤銷數量取自 PUT 回應，不許界面自己猜。", "placeholders": {"count": {"type": "int"}}},
  "stdAccountStatusRestoredNotice": "Login ability restored. Anyone acting as this account now has to log in again.",
  "@stdAccountStatusRestoredNotice": {"description": "恢復成功句：如實說明只恢復新登入資格，其他人一律重新登入。"},
  "stdAccountStatusConflictNotice": "This account's status changed after you opened this record, so nothing happened: the status was not written, no session was revoked and no audit entry was recorded. Reload the current status and confirm again.",
  "@stdAccountStatusConflictNotice": {"description": "2014 在本目錄的一句：一件都沒發生；處置是重讀現狀並重新確認，不是再點一次按鈕。"},
  "stdAccountResetScopeHint": "Resetting credentials here changes this account's sign-in password on this server: the current password stops working at once, every session he holds on any device and in any activity is signed out, and his next sign-in must change the password you hand over. A reset does not lift a suspension, does not restore a deleted account and grants no new permissions.",
  "@stdAccountResetScopeHint": {"description": "常駐說明：動的是憑據不是狀態，三件「不會發生」必須寫在同一張卡上。"},
  "stdAccountResetConfirmTitle": "Reset this account's sign-in password?",
  "@stdAccountResetConfirmTitle": {"description": "重置確認對話框標題（普通帳戶那一側，與管理員那組各是各句）。"},
  "stdAccountResetConfirmBody": "Target: {loginName}. The current password stops working immediately and all of their active sessions are signed out; the next sign-in must change the password. A reset does not restore a suspended account and does not bring back a deleted one: this is not the disable/restore path, and it is not deletion. Deliver the new password through your own offline channel - it will never be shown here again.",
  "@stdAccountResetConfirmBody": {"description": "確認文：三件效果＋兩件不會發生＋交付歸誰；{loginName} 取服務端讀回的登入名。", "placeholders": {"loginName": {"type": "String"}}},
  "stdAccountResetSuccessNotice": "Password reset. {count, plural, =0 {No active session needed to sign out.} other {{count} session(s) were signed out and must sign in again.}} Hand the temporary password over offline; first sign-in must change it.",
  "@stdAccountResetSuccessNotice": {"description": "重置成功句：撤銷數量取自 PUT 回應，不許界面自己猜。", "placeholders": {"count": {"type": "int"}}},
  "stdAccountResetGuestNotice": "This member is a guest account and has no general password, so there is nothing here to reset for them. Setting a password would amount to converting them into a standard account, which has to wait for the guest upgrade feature; choosing another target, rewording the password or signing in again changes nothing.",
  "@stdAccountResetGuestNotice": {"description": "訪客目標那句（也用於服務端 2018）：處置是等升級通路，不是改寫法或換身分。"},
